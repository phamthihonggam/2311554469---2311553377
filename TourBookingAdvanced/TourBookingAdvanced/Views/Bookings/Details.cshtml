@model TourBookingAdvanced.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">

            <h3>
                <i class="bi bi-eye-fill"></i>
                Booking Details
            </h3>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <table class="table table-bordered">

                        <tr>
                            <th width="180">Customer</th>
                            <td>@Model.CustomerName</td>
                        </tr>

                        <tr>
                            <th>Booking Date</th>
                            <td>@Model.BookingDate?.ToString("dd/MM/yyyy")</td>
                        </tr>

                        <tr>
                            <th>Total Amount</th>
                            <td class="text-success fw-bold">
                                @Model.TotalAmount?.ToString("N0") VNĐ
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

            <hr />

            <h4 class="mb-3">
                <i class="bi bi-airplane-fill"></i>
                Tour Information
            </h4>

            @foreach (var item in Model.BookingDetails)
            {
                <div class="card mb-4 border-0 shadow-sm">

                    <div class="row g-0">

                        <div class="col-md-4 text-center p-3">

                            @{
                                var images = item.Tour.ImagePaths?
                                    .Split(';', StringSplitOptions.RemoveEmptyEntries);
                            }

                            @if (images != null && images.Length > 0)
                            {
                                <img src="~/uploads/@images[0]"
                                     class="img-fluid rounded"
                                     style="height:220px;object-fit:cover;" />
                            }
                            else
                            {
                                <img src="~/images/no-image.png"
                                     class="img-fluid rounded"
                                     style="height:220px;object-fit:cover;" />
                            }

                        </div>

                        <div class="col-md-8">

                            <div class="card-body">

                                <h4 class="text-primary">
                                    @item.Tour.TourName
                                </h4>

                                <p>
                                    <strong>Passengers:</strong>
                                    @item.PassengersCount
                                </p>

                                <p>
                                    <strong>Unit Price:</strong>
                                    @item.UnitPrice.ToString("N0") VNĐ
                                </p>

                                <p>
                                    <strong>Available Slots:</strong>
                                    @item.Tour.AvailableSlots
                                </p>

                            </div>

                        </div>

                    </div>

                </div>
            }

            <div class="mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-fill"></i>

                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

            </div>

        </div>

    </div>

</div>