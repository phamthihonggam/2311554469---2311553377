@model TourBookingAdvanced.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow border-0">

                <div class="card-header bg-warning text-dark">

                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square"></i>
                        Edit Booking
                    </h3>

                </div>

                <div class="card-body">

                    <form asp-action="Edit">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-3">

                            <label asp-for="CustomerName"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="CustomerName"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="CustomerName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="BookingDate"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="BookingDate"
                                   type="date"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="BookingDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="TotalAmount"
                                   class="form-label fw-bold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    VNĐ
                                </span>

                                <input asp-for="TotalAmount"
                                       class="form-control form-control-lg" />

                            </div>

                            <span asp-validation-for="TotalAmount"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left-circle"></i>

                                Back

                            </a>

                            <button type="submit"
                                    class="btn btn-warning text-dark">

                                <i class="bi bi-check-circle-fill"></i>

                                Update Booking

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}