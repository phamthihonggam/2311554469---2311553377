@model IEnumerable<TourBookingAdvanced.Models.Tour>

@{
    ViewData["Title"] = "Tour Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-primary">

                <i class="bi bi-map-fill"></i>

                Tour Management

            </h2>

            <p class="text-muted mb-0">

                Manage all available tours

            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-success btn-lg">

            <i class="bi bi-plus-circle"></i>

            Create Tour

        </a>

    </div>

    <!-- Dashboard -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card bg-primary text-white shadow">

                <div class="card-body text-center">

                    <h2>@Model.Count()</h2>

                    <p class="mb-0">

                        Total Tours

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card shadow border-0">

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>

                        <th width="60">

                            ID

                        </th>

                        <th>

                            Tour Name

                        </th>

                        <th width="120">

                            Price

                        </th>

                        <th width="120">

                            Slots

                        </th>

                        <th width="150">

                            Category

                        </th>

                        <th width="220">

                            Images

                        </th>

                        <th width="250">

                            Action

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>#@item.Id</strong>

                            </td>

                            <td>

                                @item.TourName

                            </td>

                            <td>

                                <span class="badge bg-success fs-6">

                                    @item.Price.ToString("N0") VNĐ

                                </span>

                            </td>

                            <td>

                                <span class="badge bg-info fs-6">

                                    @item.AvailableSlots

                                </span>

                            </td>

                            <td>

                                @item.Category?.Name

                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.ImagePaths))
                                {
                                    foreach (var img in item.ImagePaths.Split(';',
                                    StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <img src="~/uploads/tours/@img"
                                             width="80"
                                             height="60"
                                             class="rounded border me-2 mb-2"
                                             style="object-fit:cover;" />
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">

                                        No Image

                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil-fill"></i>

                                        Edit

                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white">

                                        <i class="bi bi-eye-fill"></i>

                                        Details

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash-fill"></i>

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>