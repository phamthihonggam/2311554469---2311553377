@model TourBookingAdvanced.ViewModels.TourViewModel

@{
    ViewData["Title"] = "Edit Tour";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-warning">

            <h3 class="mb-0 text-dark">

                <i class="bi bi-pencil-square"></i>

                Edit Tour

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  enctype="multipart/form-data">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="TourName"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TourName"
                           class="form-control" />

                    <span asp-validation-for="TourName"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label asp-for="Price"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Price"
                                   class="form-control" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label asp-for="AvailableSlots"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="AvailableSlots"
                                   class="form-control" />

                            <span asp-validation-for="AvailableSlots"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        Category

                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryId"
                            class="form-select">
                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        Upload New Images

                    </label>

                    <input asp-for="Images"
                           type="file"
                           multiple
                           class="form-control" />

                    <small class="text-muted">

                        Leave empty if you don't want to upload new images.

                    </small>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-warning">

                    <i class="bi bi-check-circle"></i>

                    Update Tour

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}