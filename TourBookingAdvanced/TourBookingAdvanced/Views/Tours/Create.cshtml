@model TourBookingAdvanced.ViewModels.TourViewModel

@{
    ViewData["Title"] = "Create Tour";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">

                <i class="bi bi-map-fill"></i>

                Create Tour

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Create"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="TourName"
                           class="form-label"></label>

                    <input asp-for="TourName"
                           class="form-control" />

                    <span asp-validation-for="TourName"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Price"
                           class="form-label"></label>

                    <input asp-for="Price"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="AvailableSlots"
                           class="form-label"></label>

                    <input asp-for="AvailableSlots"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Category

                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryId"
                            class="form-select">
                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Tour Images

                    </label>

                    <input asp-for="Images"
                           type="file"
                           multiple
                           class="form-control" />

                </div>

                <button class="btn btn-success">

                    <i class="bi bi-check-circle"></i>

                    Save

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}